<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>git-flow</AssemblyName>
    <PackageTags>git;git-flow;karls</PackageTags>
    <PackAsTool>true</PackAsTool>
    <RollForward>Major</RollForward>
    <ToolCommandName>git-flow</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup>
    <!--RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers-->
    <PublishSelfContained>true</PublishSelfContained>
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Karls.Gitflow.Tool</PackageId>
    <Authors>Karl-Johan Sjögren</Authors>
    <Description>An easy way to manage .NET User Secrets from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- Spectre.Console.Cli carries [RequiresUnreferencedCode]/[RequiresDynamicCode] on its public API.
         The TrimmerRoots.xml ensures our command types are preserved at runtime, so these are safe to suppress. -->
    <NoWarn>NU5100;NU5119;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karls.Gitflow.Core\Karls.Gitflow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="./README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
