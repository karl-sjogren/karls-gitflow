<linker>
  <!--
    Preserve all types in our assemblies so Spectre.Console.Cli can reflect on command settings
    at runtime. Spectre.Console.Cli uses [RequiresDynamicCode] internally, and granular preservation
    of every individual command/settings type would be fragile to maintain. Our own assemblies are
    small, so the binary size impact of preserving them in full is negligible compared to the
    third-party libraries that are still trimmed normally.
  -->
  <assembly fullname="git-flow" preserve="all" />
  <assembly fullname="Karls.Gitflow.Core" preserve="all" />
</linker>
