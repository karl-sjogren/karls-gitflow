<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <Platform>x64</Platform>
    <OutputType>Package</OutputType>
    <Manufacturer>Karl-Johan Sjögren</Manufacturer>
    <!-- Default publish directory; override with -p:ToolPublishDir=<path> when building in CI -->
    <ToolPublishDir Condition="'$(ToolPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\</ToolPublishDir>
    <InstallerLicenseFile>$(MSBuildProjectDirectory)\..\..\LICENSE</InstallerLicenseFile>
    <GeneratedInstallerLicenseRtf>$(IntermediateOutputPath)installer-license.rtf</GeneratedInstallerLicenseRtf>
    <!-- Pass MSBuild properties to the WiX preprocessor so $(Version) and $(ToolPublishDir) resolve in .wxs files -->
    <DefineConstants>$(DefineConstants);Version=$(Version);ToolPublishDir=$(ToolPublishDir);GeneratedInstallerLicenseRtf=$(GeneratedInstallerLicenseRtf)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="GenerateInstallerLicenseRtf" BeforeTargets="Compile">
    <ReadLinesFromFile File="$(InstallerLicenseFile)">
      <Output TaskParameter="Lines" ItemName="InstallerLicenseLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(GeneratedInstallerLicenseRtf)"
                      Overwrite="true"
                      Lines="{\rtf1\ansi\deff0{\fonttbl{\f0 Segoe UI;}}\f0\fs20" />
    <WriteLinesToFile File="$(GeneratedInstallerLicenseRtf)"
                      Overwrite="false"
                      Lines="@(InstallerLicenseLines->'%(Identity)\line')" />
    <WriteLinesToFile File="$(GeneratedInstallerLicenseRtf)"
                      Overwrite="false"
                      Lines="}" />
  </Target>

</Project>
