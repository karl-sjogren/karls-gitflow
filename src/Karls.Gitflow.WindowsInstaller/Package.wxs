<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Karls Gitflow"
           Manufacturer="Karl-Johan Sjögren"
           Version="$(Version)"
           UpgradeCode="C43929CA-279D-42CF-A618-993747F13720"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Feature Id="ProductFeature" Title="Karls Gitflow" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Karls Gitflow" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="2677DCF6-7CAA-4E5F-9AC8-071CDC77E509">
        <File Id="GitFlowExe"
              Source="$(ToolPublishDir)git-flow.exe"
              KeyPath="yes" />
        <util:Environment Id="UpdatePath"
                          Name="PATH"
                          Value="[INSTALLFOLDER]"
                          Part="last"
                          Action="set"
                          System="yes"
                          Permanent="no" />
      </Component>
    </ComponentGroup>

  </Package>

</Wix>
